# ComfyUI — local
COMFYUI_URL=http://localhost:8188
COMFYUI_API_KEY=
COMFYUI_VERIFY_SSL=true

# ComfyUI — RunPod (set COMFYUI_VERIFY_SSL=false if corporate SSL inspection is active)
# COMFYUI_URL=https://<pod-id>-8188.proxy.runpod.net
# COMFYUI_VERIFY_SSL=false

# ComfyUI — Comfy.org Cloud (uncomment and fill to switch modes)
# COMFYUI_URL=https://api.comfy.org
# COMFYUI_API_KEY=your-comfy-org-api-key

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Cloudflare R2 (leave empty in dev — uses local fallback)
R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kitchen-designs
R2_PUBLIC_URL=https://images.kalitron.com

# Local storage fallback
OUTPUT_DIR=./outputs

# Public base URL of this gateway (used to build absolute image URLs in local storage mode)
GATEWAY_PUBLIC_URL=http://localhost:8000

# JHipster Studio backend
JHIPSTER_BACKEND_URL=http://localhost:8080

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:8080","http://localhost:9000"]
